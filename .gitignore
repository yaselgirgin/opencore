# OpenCart yerel yapılandırma dosyaları
/config.php

# Ortam ve gizli bilgi dosyaları
.env
.env.*
!.env.example

# Kullanıcı tarafından yüklenen dosyalar
/image/catalog/uploads/*
!/image/catalog/uploads/.gitkeep

# Üretilen görsel önbelleği
/image/cache/*
!/image/cache/.gitkeep


# Örnek arayüz
UI-Sample/

# IDE
/.idea/
/.vscode/
*.code-workspace

# İşletim sistemi dosyaları
.DS_Store
Thumbs.db
desktop.ini

# Geçici dosyalar
*.log
*.tmp
*.temp
*.bak
*.swp

# Veritabanı ve arşiv yedekleri
*.sql
*.sql.gz
*.zip
*.7z

# Runtime storage verileri
/system/storage/backup/*
!/system/storage/backup/.gitkeep
/system/storage/cache/*
!/system/storage/cache/.gitkeep
/system/storage/download/*
!/system/storage/download/.gitkeep
/system/storage/logs/*
!/system/storage/logs/.gitkeep
/system/storage/session/*
!/system/storage/session/.gitkeep
/system/storage/upload/*
!/system/storage/upload/.gitkeep

# Maintainer tarafında geçici üretilebilen lock dosyası
/system/storage/composer.lock
