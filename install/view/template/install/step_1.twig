{{ header }}
<div id="content">
  <div class="page-header">
    <div class="container"><h1>{{ heading_title }}</h1></div>
  </div>
  <div class="container">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-scale-balanced"></i> {{ text_step_1 }}</div>
      <div class="card-body">
        {% if error_warning %}
          <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}</div>
        {% else %}
          <div class="form-control" style="max-height: 300px; overflow-y: scroll;">{{ license|raw }}</div>
          <div class="row mt-3">
            <div class="col text-end"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}
