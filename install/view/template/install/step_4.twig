{{ header }}
<div id="content">
  <div class="page-header"><div class="container"><h1>{{ heading_title }}</h1></div></div>
  <div class="container">
    {% if text_warning %}<div class="alert alert-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_warning }}</div>{% endif %}
    <div class="card">
      <div class="card-body p-4">
        <p class="mb-4">{{ text_message }}</p>
        {% if not blocked %}<a href="{{ app }}" class="btn btn-primary"><i class="fa-solid fa-arrow-right-to-bracket"></i> {{ text_app }}</a>{% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}
