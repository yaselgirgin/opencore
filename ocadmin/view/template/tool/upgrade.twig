{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div id="alert"></div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-rotate"></i> {{ text_upgrade }}</div>
      <div class="card-body">
        <div class="row mb-3">
          <div class="col-md-4">
            <strong>{{ text_current_version }}</strong>
            <div class="fs-4">{{ current_version }}</div>
          </div>
          <div class="col-md-4">
            <strong>{{ text_latest_version }}</strong>
            <div id="latest-version" class="fs-4">-</div>
          </div>
          <div class="col-md-4">
            <strong>{{ text_status }}</strong>
            <div id="upgrade-status" class="fs-4">{{ text_not_checked }}</div>
          </div>
        </div>
        <button type="button" id="button-check" class="btn btn-primary"><i class="fa-solid fa-arrows-rotate"></i> {{ button_check }}</button>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-check').on('click', function() {
    var element = this;

    $(element).prop('disabled', true);

    $.ajax({
        url: '{{ check }}',
        dataType: 'json',
        complete: function() {
            $(element).prop('disabled', false);
        },
        success: function(json) {
            $('#alert').empty();

            if (!json.success) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json.error + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                return;
            }

            $('#latest-version').text(json.latest_version || '-');

            if (json.status === 'UPDATE_AVAILABLE') {
                $('#upgrade-status').text('{{ text_update_available|escape('js') }}').removeClass('text-success text-muted').addClass('text-warning');
            } else if (json.status === 'UP_TO_DATE') {
                $('#upgrade-status').text('{{ text_up_to_date|escape('js') }}').removeClass('text-warning text-muted').addClass('text-success');
            } else {
                $('#upgrade-status').text('{{ text_no_release|escape('js') }}').removeClass('text-warning text-success').addClass('text-muted');
            }
        },
        error: function() {
            $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_check|escape('js') }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        }
    });
});
//--></script>
{{ footer }}
