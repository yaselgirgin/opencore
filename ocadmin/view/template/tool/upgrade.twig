{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div id="alert"></div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-rotate"></i> {{ text_upgrade }}</div>
      <div class="card-body">
        <div class="row mb-3">
          <div class="col-md-4">
            <strong>{{ text_current_version }}</strong>
            <div class="fs-4">{{ current_version }}</div>
          </div>
          <div class="col-md-4">
            <strong>{{ text_latest_version }}</strong>
            <div id="latest-version" class="fs-4">-</div>
          </div>
          <div class="col-md-4">
            <strong>{{ text_status }}</strong>
            <div id="upgrade-status" class="fs-4">{{ text_not_checked }}</div>
          </div>
        </div>
        <button type="button" id="button-check" class="btn btn-primary"><i class="fa-solid fa-arrows-rotate"></i> {{ button_check }}</button>
        {% if can_modify %}
          <button type="button" id="button-prepare" class="btn btn-warning" disabled><i class="fa-solid fa-box-archive"></i> {{ button_prepare }}</button>
          <button type="button" id="button-apply" class="btn btn-danger" disabled><i class="fa-solid fa-play"></i> {{ button_apply }}</button>
          <button type="button" id="button-database" class="btn btn-danger{% if not pending_database_version %} d-none{% endif %}" data-version="{{ pending_database_version }}"><i class="fa-solid fa-database"></i> {{ button_database }}</button>
          <button type="button" id="button-recover" class="btn btn-outline-danger d-none"><i class="fa-solid fa-rotate-left"></i> {{ button_recover }}</button>
        {% endif %}
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-check').on('click', function() {
    var element = this;

    $(element).prop('disabled', true);

    $.ajax({
        url: '{{ check }}',
        dataType: 'json',
        complete: function() {
            $(element).prop('disabled', false);
        },
        success: function(json) {
            $('#alert').empty();

            if (!json.success) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json.error + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                return;
            }

            $('#latest-version').text(json.latest_version || '-');

            if (json.status === 'UPDATE_AVAILABLE') {
                $('#upgrade-status').text('{{ text_update_available|escape('js') }}').removeClass('text-success text-muted').addClass('text-warning');
                $('#button-prepare').data('version', json.latest_version).prop('disabled', false);
            } else if (json.status === 'UP_TO_DATE') {
                $('#upgrade-status').text('{{ text_up_to_date|escape('js') }}').removeClass('text-warning text-muted').addClass('text-success');
                $('#button-prepare').data('version', '').prop('disabled', true);
            } else {
                $('#upgrade-status').text('{{ text_no_release|escape('js') }}').removeClass('text-warning text-success').addClass('text-muted');
                $('#button-prepare').data('version', '').prop('disabled', true);
            }
        },
        error: function() {
            $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_check|escape('js') }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        }
    });
});

$('#button-prepare').on('click', function() {
    var element = this;

    $(element).prop('disabled', true);

    $.ajax({
        url: '{{ prepare }}',
        type: 'post',
        dataType: 'json',
        data: {version: $(element).data('version')},
        complete: function() {
            $(element).prop('disabled', false);
        },
        success: function(json) {
            $('#alert').empty();

            if (!json.success) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json.error + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                return;
            }

            var message = json.status === 'ALREADY_STAGED' ? '{{ text_already_staged|escape('js') }}' : '{{ text_staged|escape('js') }}';
            $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + message + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            $('#button-apply').data('version', json.version).prop('disabled', false);
        },
        error: function() {
            $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_prepare|escape('js') }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        }
    });
});

function mutateUpdate(url, version, element) {
    $(element).prop('disabled', true);

    $.ajax({
        url: url,
        type: 'post',
        dataType: 'json',
        data: {version: version},
        success: function(json) {
            $('#alert').empty();

            if (!json.success) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json.error + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                if (json.status === 'ROLLBACK_FAILED' || json.status === 'RECOVERY_REQUIRED' || json.status === 'DATABASE_RECOVERY_REQUIRED' || json.status === 'DATABASE_RESTORE_REQUIRED' || json.status === 'DATABASE_RESTORE_FAILED') {
                    $('#button-recover').data('version', version).removeClass('d-none');
                }
                return;
            }

            var message = json.status === 'APPLIED' ? '{{ text_applied|escape('js') }}' : (json.status === 'DATABASE_PENDING' ? '{{ text_database_pending|escape('js') }}' : '{{ text_recovered|escape('js') }}');
            $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + message + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            $('#button-database').data('version', version).toggleClass('d-none', json.status !== 'DATABASE_PENDING');
            $('#button-recover').toggleClass('d-none', json.status === 'DATABASE_PENDING');
        },
        error: function() {
            $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_apply|escape('js') }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
        }
    });
}

$('#button-apply').on('click', function() {
    mutateUpdate('{{ apply }}', $(this).data('version'), this);
});

$('#button-database').on('click', function() {
    mutateUpdate('{{ database }}', $(this).data('version'), this);
});

$('#button-recover').on('click', function() {
    mutateUpdate('{{ recover }}', $(this).data('version'), this);
});
//--></script>
{{ footer }}
