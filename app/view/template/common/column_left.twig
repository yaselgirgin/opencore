<aside id="column-left" class="navbar navbar-vertical navbar-expand-lg" aria-label="{{ text_navigation }}">
	<div class="container-fluid">
		<a id="sidebar-brand" href="{{ home }}" class="navbar-brand oc-sidebar-brand" aria-label="{{ heading_title }}" title="{{ heading_title }}"><span class="oc-brand-logo" aria-hidden="true"></span></a>
		<div id="sidebar-mobile-menu" class="sidebar-navigation collapse d-lg-block">

		<div id="navigation" class="navbar-brand">
			<span class="fa-solid fa-bars"></span>
			<span>{{ text_navigation }}</span>
		</div>

		<ul id="menu" class="navbar-nav">
			{% set i = 0 %}

			{% for menu in menus %}
				<li id="{{ menu.id }}" class="nav-item{% if menu.children %} dropdown{% endif %}">
					{% if menu.href %}
						<a href="{{ menu.href }}" class="nav-link" aria-label="{{ menu.name }}" title="{{ menu.name }}">
							<span class="nav-link-icon">
								<i class="{{ menu.icon }}"></i>
							</span>
							<span class="nav-link-title">{{ menu.name }}</span>
						</a>
					{% else %}
						<a href="#collapse-{{ i }}"
						   class="nav-link parent collapsed"
						   data-bs-toggle="collapse"
						   role="button"
						   aria-expanded="false"
						   aria-controls="collapse-{{ i }}"
						   aria-label="{{ menu.name }}"
						   title="{{ menu.name }}">
							<span class="nav-link-icon">
								<i class="{{ menu.icon }}"></i>
							</span>
							<span class="nav-link-title">{{ menu.name }}</span>
						</a>
					{% endif %}

					{% if menu.children %}
						<ul id="collapse-{{ i }}" class="collapse">
							{% set j = 0 %}

							{% for children_1 in menu.children %}
								<li class="nav-item">
									{% if children_1.href %}
										<a href="{{ children_1.href }}" class="nav-link" aria-label="{{ children_1.name }}" title="{{ children_1.name }}">
											<span class="nav-link-title">{{ children_1.name }}</span>
										</a>
									{% else %}
										<a href="#collapse-{{ i }}-{{ j }}"
										   class="nav-link parent collapsed"
										   data-bs-toggle="collapse"
										   role="button"
										   aria-expanded="false"
										   aria-controls="collapse-{{ i }}-{{ j }}"
										   aria-label="{{ children_1.name }}"
										   title="{{ children_1.name }}">
											<span class="nav-link-title">{{ children_1.name }}</span>
										</a>
									{% endif %}

									{% if children_1.children %}
										<ul id="collapse-{{ i }}-{{ j }}" class="collapse">
											{% set k = 0 %}

											{% for children_2 in children_1.children %}
												<li class="nav-item">
													{% if children_2.href %}
														<a href="{{ children_2.href }}" class="nav-link" aria-label="{{ children_2.name }}" title="{{ children_2.name }}">
															<span class="nav-link-title">{{ children_2.name }}</span>
														</a>
													{% else %}
														<a href="#collapse-{{ i }}-{{ j }}-{{ k }}"
														   class="nav-link parent collapsed"
														   data-bs-toggle="collapse"
														   role="button"
														   aria-expanded="false"
														   aria-controls="collapse-{{ i }}-{{ j }}-{{ k }}"
														   aria-label="{{ children_2.name }}"
														   title="{{ children_2.name }}">
															<span class="nav-link-title">{{ children_2.name }}</span>
														</a>
													{% endif %}

													{% if children_2.children %}
														<ul id="collapse-{{ i }}-{{ j }}-{{ k }}" class="collapse">
															{% for children_3 in children_2.children %}
																<li class="nav-item">
																	<a href="{{ children_3.href }}" class="nav-link" aria-label="{{ children_3.name }}" title="{{ children_3.name }}">
																		<span class="nav-link-title">{{ children_3.name }}</span>
																	</a>
																</li>
															{% endfor %}
														</ul>
													{% endif %}
												</li>

												{% set k = k + 1 %}
											{% endfor %}
										</ul>
									{% endif %}
								</li>

								{% set j = j + 1 %}
							{% endfor %}
						</ul>
					{% endif %}
				</li>

				{% set i = i + 1 %}
			{% endfor %}
        </ul>
        </div>

        <div id="sidebar-account" class="dropup d-none d-lg-block">
            <button type="button"
                    class="sidebar-account-toggle"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">

                <span class="sidebar-account-avatar">
                    <span class="avatar avatar-sm">
                        <img src="{{ image }}"
                             alt="{{ firstname }} {{ lastname }}"
                             title="{{ firstname }} {{ lastname }}">
                    </span>

                    <span class="badge bg-red text-white js-notification-badge notification-badge-avatar{% if not notification_total %} d-none{% endif %}">
                        {{ notification_total }}
                    </span>
                </span>

                <span class="sidebar-account-details">
                    <span class="sidebar-account-name">{{ firstname }} {{ lastname }}</span>
                    <span class="sidebar-account-group">{{ user_group }}</span>
                </span>

                <i class="fa-solid fa-ellipsis-vertical sidebar-account-menu" aria-hidden="true"></i>
            </button>

            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a href="{{ profile }}" class="dropdown-item">
                        <i class="fa-solid fa-user-circle fa-fw"></i>
                        <span>{{ text_profile }}</span>
                    </a>
                </li>

                <li>
                    <button type="button"
                            class="dropdown-item"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#offcanvas-theme-settings"
                            aria-controls="offcanvas-theme-settings">
                        <i class="fa-solid fa-palette fa-fw"></i>
                        <span>{{ text_theme_settings }}</span>
                    </button>
                </li>

                <li>
                    <a href="{{ notification_all }}" class="dropdown-item">
                        <i class="fa-regular fa-bell fa-fw"></i>
                        <span>{{ text_notification }}</span>
                        <span class="badge bg-red text-white js-notification-badge notification-badge-menu{% if not notification_total %} d-none{% endif %}">
                            {{ notification_total }}
                        </span>
                    </a>
                </li>

                <li><hr class="dropdown-divider"></li>

                <li>
                    <a href="{{ logout }}" class="dropdown-item">
                        <i class="fa-solid fa-sign-out fa-fw"></i>
                        <span>{{ text_logout }}</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</aside>
