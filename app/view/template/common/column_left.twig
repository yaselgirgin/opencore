<aside id="column-left" class="navbar navbar-vertical navbar-expand-lg" aria-label="{{ text_navigation }}">
	<div class="container-fluid">
		<div id="navigation" class="navbar-brand">
			<span class="fa-solid fa-bars"></span>
			<span>{{ text_navigation }}</span>
		</div>

		<ul id="menu" class="navbar-nav">
			{% set i = 0 %}

			{% for menu in menus %}
				<li id="{{ menu.id }}" class="nav-item{% if menu.children %} dropdown{% endif %}">
					{% if menu.href %}
						<a href="{{ menu.href }}" class="nav-link" aria-label="{{ menu.name }}" title="{{ menu.name }}">
							<span class="nav-link-icon">
								<i class="{{ menu.icon }}"></i>
							</span>
							<span class="nav-link-title">{{ menu.name }}</span>
						</a>
					{% else %}
						<a href="#collapse-{{ i }}"
						   class="nav-link parent collapsed"
						   data-bs-toggle="collapse"
						   role="button"
						   aria-expanded="false"
						   aria-controls="collapse-{{ i }}"
						   aria-label="{{ menu.name }}"
						   title="{{ menu.name }}">
							<span class="nav-link-icon">
								<i class="{{ menu.icon }}"></i>
							</span>
							<span class="nav-link-title">{{ menu.name }}</span>
						</a>
					{% endif %}

					{% if menu.children %}
						<ul id="collapse-{{ i }}" class="collapse nav flex-column">
							{% set j = 0 %}

							{% for children_1 in menu.children %}
								<li class="nav-item">
									{% if children_1.href %}
										<a href="{{ children_1.href }}" class="nav-link" aria-label="{{ children_1.name }}" title="{{ children_1.name }}">
											<span class="nav-link-title">{{ children_1.name }}</span>
										</a>
									{% else %}
										<a href="#collapse-{{ i }}-{{ j }}"
										   class="nav-link parent collapsed"
										   data-bs-toggle="collapse"
										   role="button"
										   aria-expanded="false"
										   aria-controls="collapse-{{ i }}-{{ j }}"
										   aria-label="{{ children_1.name }}"
										   title="{{ children_1.name }}">
											<span class="nav-link-title">{{ children_1.name }}</span>
										</a>
									{% endif %}

									{% if children_1.children %}
										<ul id="collapse-{{ i }}-{{ j }}" class="collapse nav flex-column">
											{% set k = 0 %}

											{% for children_2 in children_1.children %}
												<li class="nav-item">
													{% if children_2.href %}
														<a href="{{ children_2.href }}" class="nav-link" aria-label="{{ children_2.name }}" title="{{ children_2.name }}">
															<span class="nav-link-title">{{ children_2.name }}</span>
														</a>
													{% else %}
														<a href="#collapse-{{ i }}-{{ j }}-{{ k }}"
														   class="nav-link parent collapsed"
														   data-bs-toggle="collapse"
														   role="button"
														   aria-expanded="false"
														   aria-controls="collapse-{{ i }}-{{ j }}-{{ k }}"
														   aria-label="{{ children_2.name }}"
														   title="{{ children_2.name }}">
															<span class="nav-link-title">{{ children_2.name }}</span>
														</a>
													{% endif %}

													{% if children_2.children %}
														<ul id="collapse-{{ i }}-{{ j }}-{{ k }}" class="collapse nav flex-column">
															{% for children_3 in children_2.children %}
																<li class="nav-item">
																	<a href="{{ children_3.href }}" class="nav-link" aria-label="{{ children_3.name }}" title="{{ children_3.name }}">
																		<span class="nav-link-title">{{ children_3.name }}</span>
																	</a>
																</li>
															{% endfor %}
														</ul>
													{% endif %}
												</li>

												{% set k = k + 1 %}
											{% endfor %}
										</ul>
									{% endif %}
								</li>

								{% set j = j + 1 %}
							{% endfor %}
						</ul>
					{% endif %}
				</li>

				{% set i = i + 1 %}
			{% endfor %}
		</ul>
	</div>
</aside>
