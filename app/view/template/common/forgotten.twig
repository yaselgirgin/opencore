{{ header }}
<div id="content">
  <div class="container-fluid">
    <div class="row justify-content-sm-center">
      <div class="col-12 auth-layout">
        <div class="auth-brand" aria-hidden="true"><span class="oc-brand-logo"></span></div>
        <div class="card card-md">
          <div class="card-body">
            <h2 class="h2 text-center mb-4">{{ heading_title }}</h2>

            <form id="form-forgotten" class="auth-form" action="{{ confirm }}" method="post" data-oc-toggle="ajax">
              <p class="text-secondary mb-4">{{ text_email }}</p>

              <div class="mb-3">
                <label for="input-email" class="form-label">{{ entry_email }}</label>
                <input type="text" name="email" value="" placeholder="{{ entry_email }}" id="input-email" class="form-control"/>
              </div>

              <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">{{ button_reset }}</button>
              </div>

              <div class="text-center text-secondary mt-3">
                <a href="{{ back }}">{{ button_back }}</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
