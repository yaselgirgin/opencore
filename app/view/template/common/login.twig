{{ header }}
<div id="content">
  <div class="container-fluid">
    <div class="row justify-content-sm-center">
      <div class="col-12 auth-layout">
        <div class="auth-brand" aria-hidden="true">
          <span class="oc-brand-logo"></span>
        </div>

        <div class="card card-md">
          <div class="card-body">
            <h2 class="h2 text-center mb-4">{{ text_login }}</h2>

            <form id="form-login" class="auth-form" action="{{ login }}" method="post" data-oc-toggle="ajax">
              {% if error_warning %}
                <div class="alert alert-danger alert-dismissible">
                  <i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }}
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
              {% endif %}

              {% if success %}
                <div class="alert alert-success alert-dismissible">
                  <i class="fa-solid fa-check-circle"></i> {{ success }}
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
              {% endif %}

              <div class="mb-3">
                <label for="input-username" class="form-label">{{ entry_username }}</label>
                <input
                  type="text"
                  name="username"
                  value=""
                  placeholder="{{ entry_username }}"
                  id="input-username"
                  class="form-control"
                />
              </div>

              <div class="mb-2">
                <label for="input-password" class="form-label">
                  {{ entry_password }}
                  {% if forgotten %}
                    <span class="form-label-description">
                      <a href="{{ forgotten }}">{{ text_forgotten }}</a>
                    </span>
                  {% endif %}
                </label>

                <input
                  type="password"
                  name="password"
                  value=""
                  placeholder="{{ entry_password }}"
                  id="input-password"
                  class="form-control"
                />
              </div>

              <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">{{ button_login }}</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}