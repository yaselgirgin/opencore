<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <title>{{ title }}</title>
  <base href="{{ base }}"/>
  {% if description %}
    <meta name="description" content="{{ description }}"/>
  {% endif %}
  {% if keywords %}
    <meta name="keywords" content="{{ keywords }}"/>
  {% endif %}
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"/>
  <meta http-equiv="cache-control" content="no-cache">
  <meta http-equiv="expires" content="0">
  {% if logged %}
    <script>window.ocUiPreferences = {{ ui_preferences_json|raw }};</script>
  {% endif %}
  <link href="{{ tabler }}" rel="stylesheet" media="screen"/>
  <link href="{{ icons }}" rel="stylesheet" type="text/css"/>
  <link href="{{ stylesheet }}" rel="stylesheet" type="text/css"/>
  <script src="{{ jquery }}" type="text/javascript"></script>
  <script type="text/javascript" src="app/view/javascript/common.js"></script>
  {% for style in styles %}
    <link type="text/css" href="{{ style.href }}" rel="{{ style.rel }}" media="{{ style.media }}"/>
  {% endfor %}
  {% for link in links %}
    <link href="{{ link.href }}" rel="{{ link.rel }}"/>
  {% endfor %}
  {% for script in scripts %}
    <script type="text/javascript" src="{{ script.href }}"></script>
  {% endfor %}
</head>
<body class="{% if auth_page %}auth-page{% else %}layout-fluid{% endif %}">
<div id="alert"></div>
<div id="container">
  {% if not auth_page %}
  <header id="header" class="navbar navbar-expand-md navbar-light d-print-none">
    <div class="container-fluid">
      <a href="{{ home }}" class="navbar-brand" aria-label="{{ heading_title }}" title="{{ heading_title }}"><span class="oc-brand-logo" aria-hidden="true"></span></a>
      {% if logged and not auth_page %}
        <button type="button" id="button-menu" class="btn btn-icon d-inline-flex d-lg-none"><i class="fa-solid fa-bars"></i></button>
        <ul class="navbar-nav flex-row order-md-last ms-auto align-items-center">
          <li id="nav-notification" class="nav-item dropdown">
            <a href="#"
              class="nav-link px-2"
              data-bs-toggle="dropdown"
              aria-label="{{ text_notification }}">
              <i class="fa-regular fa-bell"></i>
              {% if notification_total %}
                <span class="badge bg-danger">{{ notification_total }}</span>
              {% endif %}
            </a>

            <div id="notification-dropdown" class="dropdown-menu dropdown-menu-end p-0">
              <div class="notification-header">
                <strong>{{ text_notification }}</strong>
              </div>

              <div class="notification-list">
                {% if notifications %}
                  {% for notification in notifications %}
                    <a href="{{ notification.href }}"
                      data-bs-toggle="modal"
                      class="notification-item">
                      <span class="notification-status"></span>

                      <span class="notification-content">
                        {{ notification.title }}
                      </span>
                    </a>
                  {% endfor %}
                {% else %}
                  <div class="notification-empty">
                    {{ text_no_results }}
                  </div>
                {% endif %}
              </div>

              {% if notifications %}
                <div class="notification-footer">
                  <a href="{{ notification_all }}">
                    {{ text_notification_all }}
                  </a>
                </div>
              {% endif %}
            </div>
          </li>

          <li id="nav-language" class="nav-item dropdown">
            {{ language }}
          </li>

          <li id="nav-profile" class="nav-item dropdown">
            <a href="#"
              class="nav-link d-flex align-items-center px-2"
              data-bs-toggle="dropdown">
              <span class="avatar avatar-sm">
                <img src="{{ image }}"
                    alt="{{ firstname }} {{ lastname }}"
                    title="{{ firstname }} {{ lastname }}">
              </span>

              <div class="d-none d-xl-block ps-2">
                <div>{{ firstname }} {{ lastname }}</div>
              </div>
            </a>

            <ul id="profile-dropdown" class="dropdown-menu dropdown-menu-end p-0">
              <li class="profile-dropdown-header">
                <span class="avatar avatar-sm">
                  <img src="{{ image }}"
                      alt="{{ firstname }} {{ lastname }}"
                      title="{{ firstname }} {{ lastname }}">
                </span>

                <div>
                  <div class="profile-dropdown-name">{{ firstname }} {{ lastname }}</div>
                </div>
              </li>

              <li class="dropdown-divider m-0"></li>

              <li>
                <a href="{{ profile }}" class="dropdown-item">
                  <i class="fa-solid fa-user-circle fa-fw"></i>
                  <span>{{ text_profile }}</span>
                </a>
              </li>

              <li>
                <button type="button" class="dropdown-item" data-bs-toggle="offcanvas" data-bs-target="#offcanvas-theme-settings" aria-controls="offcanvas-theme-settings">
                  <i class="fa-solid fa-palette fa-fw"></i>
                  <span>{{ text_theme_settings }}</span>
                </button>
              </li>

              <li class="dropdown-divider m-0"></li>

              <li class="dropdown-header">{{ text_help }}</li>

              <li>
                <a href="https://www.opencart.com"
                  target="_blank"
                  class="dropdown-item">
                  <i class="fa-brands fa-opencart fa-fw"></i>
                  <span>{{ text_homepage }}</span>
                </a>
              </li>

              <li>
                <a href="https://docs.opencart.com"
                  target="_blank"
                  class="dropdown-item">
                  <i class="fa-solid fa-file fa-fw"></i>
                  <span>{{ text_documentation }}</span>
                </a>
              </li>

              <li>
                <a href="https://forum.opencart.com"
                  target="_blank"
                  class="dropdown-item">
                  <i class="fa-solid fa-comments fa-fw"></i>
                  <span>{{ text_support }}</span>
                </a>
              </li>
            </ul>
          </li>

          <li id="nav-logout" class="nav-item">
            <a href="{{ logout }}" class="nav-link px-2">
              <i class="fa-solid fa-sign-out me-1"></i>
              <span class="d-none d-md-inline">{{ text_logout }}</span>
            </a>
          </li>
        </ul>
      {% endif %}
    </div>
  </header>
  {% if logged %}
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvas-theme-settings" aria-labelledby="offcanvas-theme-settings-label">
      <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="offcanvas-theme-settings-label">{{ text_theme_settings }}</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="{{ button_close }}"></button>
      </div>
      <div class="offcanvas-body">
        <form id="form-theme-settings" action="{{ save_preferences }}" method="post">
          {% for field in ui_preference_fields %}
            <div class="theme-settings-field mb-4">
              <div class="form-label">{{ field.label }}</div>
              {% if field.name == 'color_scheme' %}
                <div class="d-flex flex-wrap gap-2">
                  {% for option in field.options %}
                    <label class="form-colorinput" title="{{ option.text }}">
                      <input type="radio" name="{{ field.name }}" value="{{ option.value }}" class="form-colorinput-input" aria-label="{{ option.text }}"{% if option.value == field.value %} checked{% endif %}/>
                      <span class="form-colorinput-color bg-{{ option.value }}"></span>
                    </label>
                  {% endfor %}
                </div>
              {% else %}
                <div class="theme-settings-radios">
                  {% for option in field.options %}
                    <div class="form-check">
                      <input type="radio" name="{{ field.name }}" value="{{ option.value }}" id="input-{{ field.name }}-{{ option.value }}" class="form-check-input"{% if option.value == field.value %} checked{% endif %}/>
                      <label for="input-{{ field.name }}-{{ option.value }}" class="form-check-label">{{ option.text }}</label>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
          <p class="text-secondary small mb-0">{{ text_theme_settings_saved }}</p>
        </form>
      </div>
    </div>
  {% endif %}
  {% endif %}
  <div class="page-wrapper">
